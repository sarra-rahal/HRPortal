<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"  name="work_certificate">
<parameter name="name" class="java.lang.String"/>
<parameter name="content" class="java.lang.String"/>
<parameter name="generatedBy" class="java.lang.String"/>
<parameter name="generatedDate" class="java.lang.String"/>
<detail>
<band height="125">
    <textField>
        <reportElement x="0" y="0" width="200" height="30"/>
        <textFieldExpression><![CDATA[$P{name}]]></textFieldExpression>
    </textField>
    <textField>
        <reportElement x="0" y="30" width="500" height="30"/>
        <textFieldExpression><![CDATA[$P{content}]]></textFieldExpression>
    </textField>
    <textField>
        <reportElement x="0" y="60" width="200" height="30"/>
        <textFieldExpression><![CDATA["Generated by: " + $P{generatedBy}]]></textFieldExpression>
    </textField>
    <textField>
        <reportElement x="0" y="90" width="200" height="30"/>
        <textFieldExpression><![CDATA["Date: " + $P{generatedDate}]]></textFieldExpression>
    </textField>
</band>
</detail>
        </jasperReport>